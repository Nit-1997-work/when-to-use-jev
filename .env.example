# --- LLM gateway: LiteLLM-based, compatible with OpenAI's Chat Completions API ---
# All LLM (Gemini) calls go through this gateway; there are no direct provider calls.
OPENAI_API_BASE=''
OPENAI_API_KEY=changeme

# Baseline: a low-latency model typical of LLM intent classifiers.
BASELINE_MODEL='google/gemini-3.5-flash-lite'
# Optional second baseline (a larger general-purpose model). Leave empty to skip.
BASELINE_MODEL_2='google/gemini-3.7-flash'
# Optional reasoning-effort override forwarded to the LiteLLM gateway. Leave empty to use the
# provider default (for gemini-3.5-flash-lite that is thinking_level="minimal").
BASELINE_REASONING_EFFORT=
# Same for BASELINE_MODEL_2. gemini-3.7-flash reasons by default and rejects 'minimal'/'none' through the gateway.
# 'low' is its lowest accepted level; with the 46-intent prompt it still used 24-148 reasoning tokens per call
# (5th to 95th percentile in the published run).
BASELINE_2_REASONING_EFFORT='low'


# --- TypeSafe / Jev (variable names match the typesafe_sdk defaults) ---
TYPESAFE_API_KEY=changeme
TYPESAFE_BASE_URL='https://api.typesafe.ai'
# Pin the versioned ID, not the moving jev-latest alias.
TYPESAFE_DEFAULT_MODEL='jev-1.13.0'

# --- Prices in USD per 1M tokens, used for the cost report ---
# Fill in from the published price sheets on the run date. Every run manifest records these values, and the report
# prices tokens from the manifest, so later edits here never change a finished run's costs.
JEV_INPUT_PRICE_PER_MTOK=0.042
# Source for the Jev price (URL and the date you read it), recorded in every run manifest.
JEV_PRICE_SOURCE_URL=
BASELINE_INPUT_PRICE_PER_MTOK=
BASELINE_OUTPUT_PRICE_PER_MTOK=
# Thinking tokens are usually billed at the output rate; set explicitly if different.
BASELINE_THINKING_PRICE_PER_MTOK=
BASELINE_2_INPUT_PRICE_PER_MTOK=
BASELINE_2_OUTPUT_PRICE_PER_MTOK=
BASELINE_2_THINKING_PRICE_PER_MTOK=
# Source for the Gemini prices above (URL and the date you read it), recorded in every run manifest.
# Use the price sheet of the endpoint your gateway calls: on Vertex AI
# (https://cloud.google.com/vertex-ai/generative-ai/pricing), regional endpoints cost more than the global one.
BASELINE_PRICE_SOURCE_URL=

# --- Run settings ---
REQUEST_TIMEOUT_SECONDS=30
# Where the client runs, recorded with latency results (e.g. "laptop, US East, home wifi").
CLIENT_LOCATION=

# --- Phoenix (optional; `make phoenix` starts it locally) ---
# Leave PHOENIX_COLLECTOR_ENDPOINT empty to run without tracing.
# If port 6006 is taken on your machine, pick another host port and use it in both URLs below.
PHOENIX_HOST_PORT=6006
PHOENIX_COLLECTOR_ENDPOINT='http://localhost:6006'
PHOENIX_BASE_URL='http://localhost:6006'
# Traces go to one Phoenix project per system: <prefix>-<system>.
PHOENIX_PROJECT_PREFIX='jevbench'

# --- TLS ---
# jevbench trusts the OS certificate store (works behind corporate TLS inspection). Set 0 to use certifi only.
JEVBENCH_TRUSTSTORE=1
