# --- LLM gateway: LiteLLM-based, compatible with OpenAI's Chat Completions API ---
# All LLM (Gemini) calls go through this gateway; there are no direct provider calls.
OPENAI_API_BASE=''
OPENAI_API_KEY=changeme

# Baseline: a low-latency model typical of LLM intent classifiers.
BASELINE_MODEL='google/gemini-3.5-flash-lite'
# Optional second baseline (a larger general-purpose model). Leave empty to skip.
BASELINE_MODEL_2='google/gemini-3.7-flash'
# Optional reasoning-effort override forwarded to the LiteLLM gateway. Leave empty to use the
# provider default (for gemini-3.5-flash-lite that is thinking_level="minimal").
BASELINE_REASONING_EFFORT=


# --- TypeSafe / Jev (variable names match the typesafe_sdk defaults) ---
TYPESAFE_API_KEY=changeme
TYPESAFE_BASE_URL='https://api.typesafe.ai'
# Pin the versioned ID, not the moving jev-latest alias.
TYPESAFE_DEFAULT_MODEL='jev-1.13.0'

# --- Prices in USD per 1M tokens, used for the cost report ---
# Fill in from the published price sheets on the run date; the report records these values.
JEV_INPUT_PRICE_PER_MTOK=0.042
BASELINE_INPUT_PRICE_PER_MTOK=
BASELINE_OUTPUT_PRICE_PER_MTOK=
# Thinking tokens are usually billed at the output rate; set explicitly if different.
BASELINE_THINKING_PRICE_PER_MTOK=
BASELINE_2_INPUT_PRICE_PER_MTOK=
BASELINE_2_OUTPUT_PRICE_PER_MTOK=
BASELINE_2_THINKING_PRICE_PER_MTOK=
# Source URL for the Gemini prices above, recorded in results for the blog.
BASELINE_PRICE_SOURCE_URL=

# --- Run settings ---
REQUEST_TIMEOUT_SECONDS=30
# Where the client runs, recorded with latency results (e.g. "laptop, US East, home wifi").
CLIENT_LOCATION=
